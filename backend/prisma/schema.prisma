generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
    @@map("users")
    
    id              Int      @id @default(autoincrement())
    username        String   @unique
    email           String   @unique
    password        String
    links           Link[]
    userSettings    UserSettings?
    
    created_at      DateTime @default(now())
    updated_at      DateTime @updatedAt
}

model Link {
    user            User    @relation(fields: [user_id], references: [id])

    id              Int     @id @default(autoincrement())
    user_id         Int
    url             String
    title           String
    icon_type       IconType
    icon_url        String?
    description     String?

}

enum IconType {
    DEFAULT
    LETTERS
    IMAGE
}

model UserSettings {
    user            User    @relation(fields: [user_id], references: [id])
    
    user_id         Int     @id
}